# Copy to .env (git-ignored) and fill in locally. NEVER commit a filled .env.
# This file must contain placeholders only — no real keys, ever.

# --- runtime posture -------------------------------------------------------
# development | testing | paper | canary | production
ARBCORE_ENV=development
# research | paper | canary | live
ARBCORE_TRADING_MODE=research

# Real-money execution requires ALL of: a permitting environment, a real-money
# trading mode, this flag, an approval reference, and every readiness flag.
ARBCORE_LIVE_TRADING_ENABLED=false
ARBCORE_MANUAL_APPROVAL_REF=

# --- live readiness checklist (all must be true for canary/live) -----------
ARBCORE_READY_CRITICAL_TESTS_PASSING=false
ARBCORE_READY_SECURITY_REVIEW_COMPLETE=false
ARBCORE_READY_RISK_LIMITS_CONFIGURED=false
ARBCORE_READY_MONITORING_OPERATIONAL=false
ARBCORE_READY_RECONCILIATION_OPERATIONAL=false
ARBCORE_READY_KILL_SWITCH_TESTED=false
ARBCORE_READY_PAPER_TRADING_COMPLETED=false
ARBCORE_READY_OUT_OF_SAMPLE_VALIDATION_COMPLETED=false

# --- credentials -----------------------------------------------------------
# Not used in Phase 1: no venue adapters exist yet. When adapters are added,
# keys must be READ + TRADE only, with withdrawal permission DISABLED, and
# should be injected by a secret manager rather than a file wherever possible.
